NODE_ENV=development
HOST=0.0.0.0
PORT=5000
DATABASE_URL=postgresql://nabha_app:CHANGE_ME_LONG_RANDOM_PASSWORD@localhost:5432/nabha_telemedicine
PGHOST=localhost
PGPORT=5432
PGUSER=nabha_app
PGPASSWORD=CHANGE_ME_LONG_RANDOM_PASSWORD
PGDATABASE=nabha_telemedicine
JWT_SECRET=CHANGE_ME_LONG_RANDOM_SECRET_32_CHARS_MIN
JWT_REFRESH_SECRET=CHANGE_ME_DIFFERENT_LONG_RANDOM_SECRET_32_CHARS_MIN
IVR_WEBHOOK_SECRET=CHANGE_ME_LONG_RANDOM_WEBHOOK_SECRET
CORS_ORIGIN=http://localhost:8000
AI_PROVIDER=fastapi
AI_SERVICE_URL=http://localhost:8001
VIDEO_PROVIDER=zoom
IVR_PROVIDER=exotel
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
EMAIL_PROVIDER=resend
EMAIL_API_KEY=
EMAIL_FROM=Nabha Telemedicine <no-reply@example.com>
FRONTEND_BASE_URL=http://localhost:8000
PASSWORD_RESET_EXPIRES_MINUTES=30
ALLOW_PASSWORD_RESET_LOG=true
# Used only by the local demo seed; never use it in production.
SEED_PASSWORD=CHANGE_ME_LOCAL_ONLY_PASSWORD

# Used by `npm run admin:create` during deployment. Keep these in deployment secrets.
ADMIN_NAME=Platform Administrator
ADMIN_EMAIL=admin@example.com
ADMIN_MOBILE=9000000000
ADMIN_PASSWORD=CHANGE_ME_LONG_RANDOM_ADMIN_PASSWORD
